# Copy to deploy/.env.production on the server (chmod 600). Never commit it.
APP_DOMAIN=app.atsync.tech

# Use hex so it is safe inside a URL:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Sessions are signed with this:  openssl rand -hex 32
SECRET_KEY=
# Encrypts clients' SMTP passwords. Generate ONCE and back it up somewhere safe:
#   docker run --rm python:3.11-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# If you lose it, every stored mailbox password becomes unreadable.
ENCRYPTION_KEY=

GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
