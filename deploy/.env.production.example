# Copy to deploy/.env.production on the server (chmod 600). Never commit it.
APP_DOMAIN=app.atsync.tech
# Docker bridge address that the existing Caddy reaches as host.docker.internal (check: docker exec caddy getent hosts host.docker.internal)
EDGE_BIND=172.16.0.1

# Use hex so it is safe inside a URL:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Sessions are signed with this:  openssl rand -hex 32
SECRET_KEY=
# Encrypts clients' SMTP passwords. Generate ONCE and back it up somewhere safe. If you lose it,
# every stored mailbox password becomes unreadable.
ENCRYPTION_KEY=

GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
